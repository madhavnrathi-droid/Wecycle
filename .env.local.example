# Wecycle — local environment
# Copy to .env.local and fill in. .env.local is gitignored; never commit it.
#
# Production runs on APPWRITE. Supabase is still configured as the way back —
# set NEXT_PUBLIC_BACKEND=supabase and the app talks to Supabase instead, with
# no code change. See HANDOFF.md.

# ── Which backend the app talks to ─────────────────────────────────────────
NEXT_PUBLIC_BACKEND=appwrite

# ── Appwrite (production) ──────────────────────────────────────────────────
# All three are PUBLIC by design — they ship in the browser bundle.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT=6aacfd62003de774675c
NEXT_PUBLIC_APPWRITE_DB=wecycle

# Server-only. Used by app/api/rpc/[fn] for the operations a browser must not
# perform (counters on other people's rows, contact details, account deletion).
# NEVER prefix this NEXT_PUBLIC_ — anything with that prefix ships to every
# visitor. Ask the project owner for a key; do not reuse the production one.
# APPWRITE_API_KEY=

# ── Supabase (the rollback path) ───────────────────────────────────────────
# Publishable key, safe to ship. Only read when NEXT_PUBLIC_BACKEND=supabase.
NEXT_PUBLIC_SUPABASE_URL=https://oxqnwqaumrqdiwrlvfel.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_71Pg6dAe_KToAKCA7YDUYg_Owvvl4Nl

# ── Optional ───────────────────────────────────────────────────────────────
# Web push (public half of the VAPID pair).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# remove.bg, proxied via /api/remove-background. Server-only.
# REMOVE_BG_API_KEY=

# Remote status banner, read by /api/status. JSON; unset means no banner.
# See docs/app-update-flow.md.
# APP_STATUS=
