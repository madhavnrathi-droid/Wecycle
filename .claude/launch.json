{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wecycle-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "wecycle-desktop",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "-p", "3100"],
      "port": 3100,
      "autoPort": false
    },
    {
      "name": "mockups",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "3201", "--directory", "play-assets/mockups"],
      "port": 3201,
      "autoPort": true
    }
  ]
}
