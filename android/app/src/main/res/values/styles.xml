<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- The app is inset by MainActivity and the band behind the status bar
             is white, so the clock and battery must be drawn dark. -->
        <item name="android:windowLightStatusBar">true</item>
        <!-- Say what should happen at the camera cutout instead of inheriting
             a default that changed between platform versions. shortEdges lets
             the window extend into the cutout on the short edge, which is what
             makes the cutout appear in the insets MainActivity reads; the
             WebView is then padded clear of it. Leaving this unset means the
             behaviour depends on the OS version and the OEM, which is how the
             wordmark ended up under the camera on some devices and not others. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
