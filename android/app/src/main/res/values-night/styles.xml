<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Dark mode. Identical to values/styles.xml except for the status-bar
         icons: in dark mode the strip the web layer paints behind the status
         bar takes the dark card colour #1C1C1A, so the clock and battery need
         to be light again. A style override has to restate the whole style,
         hence the duplication — keep the two in step.

         The colour was written here as a CSS custom-property name. XML forbids
         a double hyphen inside a comment, so aapt2 failed the whole release
         build on it ("The string is not permitted within comments"). Nothing
         had caught it because the debug path had not been rebuilt since the
         comment was written. Do not reintroduce a var() name here. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
