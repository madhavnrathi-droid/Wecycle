# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# capacitor: temp route-stash during the static export build
/.cap-excluded/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Superseded standalone prototype — kept locally but NOT part of the Next app
# build, and it carried a stray service-role key for an old Supabase project.
# Untracked so it stops shipping in the repo. (Rotate that old key separately.)
Wecycle Circular Economy Platform/
Wecycle Circular Economy Platform.zip

# Superseded native experiments — the Capacitor shell in android/ is the real
# one. Kept locally for reference, not part of the repo.
mobile-expo/
android-twa/
assets/
expo-qr.png

# Claude Code worktrees
.claude/

# Android signing — never commit the keystore or its password. The release
# build reads them from local files that stay on this machine only.
*.keystore
*.jks
.keystore-password
service-account*.json

# Supabase CLI scratch — version checks and link state, not source.
supabase/.temp/

# iOS build output — archives and IPAs are large artifacts, never source
ios/build/
ios/App/App/public/
ios/App/App/capacitor.config.json

# iOS build products — archives and exported ipas are large and rebuildable
ios/build/
